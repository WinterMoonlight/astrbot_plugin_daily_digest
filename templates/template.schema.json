{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Daily digest Typst template manifest v2",
  "type": "object",
  "required": [
    "schemaVersion",
    "engine",
    "id",
    "name",
    "version",
    "width",
    "entry"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 2
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "width": {
      "type": "integer",
      "minimum": 640,
      "maximum": 1600
    },
    "assets": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "stickers": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "stickerCycle": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "fonts": {
      "type": "object",
      "required": [
        "faces",
        "roles"
      ],
      "additionalProperties": false,
      "properties": {
        "faces": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "family",
              "weight",
              "file",
              "distribution"
            ],
            "additionalProperties": false,
            "properties": {
              "family": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9 -]*$"
              },
              "weight": {
                "type": "integer",
                "minimum": 100,
                "maximum": 900
              },
              "file": {
                "type": "string",
                "pattern": "^assets/fonts/(?!.*\\.\\.)(?!.*\\\\).+\\.(ttf|TTF|otf|OTF|woff|woff2)$"
              },
              "distribution": {
                "enum": [
                  "private",
                  "bundled"
                ]
              }
            }
          }
        },
        "roles": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "body": {
              "$ref": "#/$defs/fontRole"
            },
            "display": {
              "$ref": "#/$defs/fontRole"
            },
            "latin": {
              "$ref": "#/$defs/fontRole"
            }
          }
        }
      }
    },
    "entry": {
      "type": "string",
      "pattern": "^(?!.*\\.\\.)(?!.*\\\\).+\\.typ$"
    },
    "closingCopy": {
      "type": "string",
      "minLength": 1
    },
    "engine": {
      "const": "typst"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "fontRole": {
      "type": "object",
      "required": [
        "family",
        "fallback"
      ],
      "additionalProperties": false,
      "properties": {
        "family": {
          "type": "string"
        },
        "fallback": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
